# Copy to .env and adjust. Never commit .env.

# --- Database (used by docker-compose and the backend) ---
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_matcher
POSTGRES_PORT=5432
# Use 127.0.0.1, not localhost: Postgres is published on IPv4 only, and on Windows
# "localhost" tries IPv6 (::1) first, which hangs until the connect timeout.
DATABASE_URL=postgresql+psycopg://resume:resume@127.0.0.1:5432/resume_matcher

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=5
MAX_BATCH_FILES=50
# "Load sample data": where the synthetic JDs and resumes are (default: the repo's sample_data)
# SAMPLE_DATA_DIR=../sample_data
# Default region for parsing phone numbers without a country code (ISO 3166-1 alpha-2)
PHONE_DEFAULT_REGION=IN

# --- NLP ---
# Any 384-dimensional sentence-transformers model (e.g. BAAI/bge-small-en-v1.5).
# After changing it, run: scripts/seed_skills.py --reembed
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_BATCH_SIZE=32

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
