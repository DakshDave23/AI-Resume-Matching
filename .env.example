# Copy to .env and adjust. Never commit .env.

# --- Database (used by docker-compose and the backend) ---
POSTGRES_USER=resume
POSTGRES_PASSWORD=resume
POSTGRES_DB=resume_matcher
POSTGRES_PORT=5432
DATABASE_URL=postgresql+psycopg://resume:resume@localhost:5432/resume_matcher

# --- Backend ---
APP_ENV=development
LOG_LEVEL=INFO
# Comma-separated list of allowed frontend origins
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./storage/uploads
MAX_FILE_SIZE_MB=5
MAX_BATCH_FILES=50
# Default region for parsing phone numbers without a country code (ISO 3166-1 alpha-2)
PHONE_DEFAULT_REGION=IN

# --- NLP ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
SPACY_MODEL=en_core_web_sm

# --- Frontend ---
VITE_API_BASE_URL=http://localhost:8000/api/v1
